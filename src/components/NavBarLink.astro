---
import config from "virtual:starlight/user-config";
import { MenuData } from "../constants";
import type { NavItemProps } from "../type";
import type { Props } from "@astrojs/starlight/props";

const [, baseSegment] = Astro.url.pathname.split("/");
const isEnglish = config.locales?.[baseSegment]?.lang === "en";
const labelFor = (item: NavItemProps) =>
  (isEnglish ? item.labelEn : item.label) ?? item.label;
const linkFor = (item: NavItemProps) =>
  (isEnglish ? item.linkEn : item.link) ?? item.link;
const linkAttributes = (item: NavItemProps) => {
  const href = linkFor(item);
  const external = !!href && /^https?:\/\//i.test(href);
  return {
    href,
    target: external ? "_blank" : undefined,
    rel: external ? "noopener noreferrer" : undefined,
  };
};
---

<nav class="site-navigation" aria-label={isEnglish ? "Main navigation" : "主导航"}>
  {
    MenuData.map((menu) =>
      menu.items?.length ? (
        <details class="dropdown">
          <summary class="dropdown-button">
            {menu.link ? (
              <a {...linkAttributes(menu)}>{labelFor(menu)}</a>
            ) : (
              <span>{labelFor(menu)}</span>
            )}
            <span class="caret" aria-hidden="true" />
          </summary>
          <div class="dropdown-content">
            {menu.items.map((item) =>
              item.items?.length ? (
                <details class="submenu">
                  <summary>
                    <a {...linkAttributes(item)}>{labelFor(item)}</a>
                    <span class="caret" aria-hidden="true" />
                  </summary>
                  <div class="submenu-content">
                    {item.items.map((child: NavItemProps) => (
                      <a {...linkAttributes(child)}>{labelFor(child)}</a>
                    ))}
                  </div>
                </details>
              ) : (
                <a {...linkAttributes(item)}>{labelFor(item)}</a>
              ),
            )}
          </div>
        </details>
      ) : (
        <a class="dropdown-button" {...linkAttributes(menu)}>{labelFor(menu)}</a>
      ),
    )
  }
</nav>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(
      ".site-navigation details[open]",
    )) {
      if (!menu.contains(event.target)) menu.open = false;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !(event.target instanceof Element)) return;
    const menu = event.target.closest<HTMLDetailsElement>(
      ".site-navigation details[open]",
    );
    if (!menu) return;
    menu.open = false;
    menu.querySelector<HTMLElement>(":scope > summary")?.focus();
    event.preventDefault();
  });
</script>

<style>
  .site-navigation {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-button,
  .submenu > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 0.375rem;
    color: var(--sl-color-white);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .dropdown-button {
    white-space: nowrap;
  }

  .caret {
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    margin-inline: 0.25rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.15rem) rotate(45deg);
  }

  details[open] > summary > .caret {
    transform: translateY(0.1rem) rotate(225deg);
  }

  .dropdown-button:hover,
  .submenu > summary:hover,
  .dropdown-content a:hover {
    color: var(--sl-color-text-invert);
    background-color: var(--sl-color-text-accent);
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .dropdown-content {
    position: absolute;
    inset-inline-start: 0;
    top: 100%;
    min-width: 15rem;
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - var(--sl-nav-height) - 1rem);
    overflow-y: auto;
    padding: 0.25rem;
    background-color: var(--sl-color-bg-sidebar);
    border-radius: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 0.5rem 1.5rem #0002;
    z-index: 10;
  }

  .dropdown-content a {
    display: block;
    padding: 0.5rem;
    border-radius: 0.3rem;
  }

  .submenu > summary {
    padding: 0 0.5rem 0 0;
  }

  .submenu > summary a {
    flex: 1;
  }

  .submenu-content {
    margin: 0.25rem 0.5rem 0.5rem;
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    font-size: 0.875rem;
  }

  @media (max-width: 49.999rem) {
    .site-navigation {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }

    .dropdown-content {
      position: static;
      min-width: 0;
      max-width: none;
      max-height: none;
      box-shadow: none;
    }
  }
</style>
